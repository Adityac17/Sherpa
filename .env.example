# =================================================================
# Personalized Learning Resource Recommender - Environment Variables
# =================================================================

# 1. AI Engine: FreeLLMAPI (Unified Free LLM Router / 7B Free Key)
# Documentation: https://github.com/tashfeenahmed/freellmapi
# By default, connects to FreeLLMAPI local proxy on port 3001 or external provider
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_API_KEY=YOUR_FREELLMAPI_KEY
FREELLMAPI_MODEL=7b

# Alternative AI Engine: Google Gemini API (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Fallback AI Engine: NVIDIA NIM API (https://build.nvidia.com)
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY

# 2. Storage: Firebase SDK (Firestore)
# Create a free project at https://console.firebase.google.com
FIREBASE_API_KEY=AIzaSyDemoKey
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# (Fallback persistent local storage in data/runs.json is active if Firebase credentials are omitted)

# 3. Automated Action: Email Dispatch via Resend (Optional - falls back to proof log)
# Get a free API key at https://resend.com
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=LearnPath <onboarding@resend.dev>

# 4. Automated Action: n8n Webhook (Optional - for n8n workflow execution)
# Import n8n/learning_recommender_workflow.json into your n8n instance
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/learning-recommendations

# 5. Local Server Settings
PORT=3000
NODE_ENV=development
